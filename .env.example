# Kopieer naar .env en pas aan waar nodig. Alles heeft een werkende standaard.

# Waar de app naar luistert. In Docker: 0.0.0.0 (de poortmapping beperkt het
# al tot 127.0.0.1 op de host). Los gestart: laat leeg voor 127.0.0.1.
CSS_HOST=0.0.0.0
CSS_PORT=8304

# Choice-drempel van AliExpress: vanaf dit bedrag aan Choice-artikelen in je
# mandje is de verzending daarvan gratis en versneld.
CSS_CHOICE_MIN_EUR=10
# Waarmee we rekenen als de winkel geen verzendkosten toont (altijd als
# schatting gemarkeerd in de UI).
CSS_SHIPPING_FALLBACK_EUR=2.99
# Temu's eigen gratis-verzendgrens (alleen gebruikt als Temu-data beschikbaar is).
CSS_TEMU_FREE_SHIPPING_EUR=10

# Hoeveel resultaten per winkel.
CSS_MAX_RESULTS=40
# Hoe lang een zoekopdracht in de cache blijft (seconden).
CSS_SEARCH_CACHE_TTL_S=300

# Bewaarplaats voor afbeeldingshashes.
CSS_IMAGE_CACHE=/data/image-cache

# Optioneel: cookies van een ingelogd Temu-account. Zonder dit is Temu
# geblokkeerd (zie README). Nooit in git.
CSS_TEMU_COOKIES=/secrets/temu-cookies.json
